<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork：所有弹出菜单都是玻璃（见 sp/phone/view/glass/GlassPopupDrawable.kt）。
  标题栏三个点菜单走 AppTheme.PopupOverlay（styles.xml），其余（每楼的菜单等 PopupMenu）走应用主题的 popupMenuStyle。
  白天是浅色玻璃配深色字，夜间（values-night/fork_styles.xml）是深色玻璃配浅色字。
-->
<resources>
    <style name="Fork.ThemeOverlay.GlassPopup" parent="ThemeOverlay.AppCompat.Light">
        <item name="actionOverflowMenuStyle">@style/Fork.Widget.GlassOverflowMenu</item>
        <item name="popupMenuStyle">@style/Fork.Widget.GlassPopupMenu.AppCompat</item>
        <item name="android:popupMenuStyle">@style/Fork.Widget.GlassPopupMenu</item>
    </style>

    <!-- 三个点菜单：玻璃背景，从标题栏下沿弹出，不盖住标题栏 -->
    <style name="Fork.Widget.GlassOverflowMenu" parent="Widget.AppCompat.Light.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/fork_glass_popup</item>
        <!-- 不要投影：半透明背景会把投影透出一圈灰边 -->
        <item name="android:popupElevation">0dp</item>
        <item name="overlapAnchor">false</item>
        <item name="android:overlapAnchor">false</item>
        <!-- 明确指定偏移：不设时会按背景内边距往上挪，盖住标题栏下沿一截 -->
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <!-- androidx.appcompat.widget.PopupMenu -->
    <style name="Fork.Widget.GlassPopupMenu.AppCompat" parent="Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/fork_glass_popup</item>
        <item name="android:popupElevation">0dp</item>
    </style>

    <!-- android.widget.PopupMenu（比如每楼右下角三个点的菜单） -->
    <style name="Fork.Widget.GlassPopupMenu" parent="@android:style/Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/fork_glass_popup</item>
        <item name="android:popupElevation">0dp</item>
    </style>
</resources>
